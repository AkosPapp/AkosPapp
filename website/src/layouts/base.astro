---
import { nav } from "../data";

interface Props {
  title: string;
  description: string;
  active?: string;
}

const { title, description, active } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://akosp.app/#person",
  name: "Akos Papp",
  alternateName: ["Ákos Papp", "Papp Akos", "Akos"],
  url: "https://akosp.app/",
  image: "https://akosp.app/og.png",
  jobTitle: "Computer Engineering Student · Robotics & AI",
  description:
    "Akos Papp is a Computer Engineering student at TU Wien and international robotics competitor — IEIIC world champion, A2RL winner, VEX AI and Botball World Championship medalist.",
  address: { "@type": "PostalAddress", addressLocality: "Vienna", addressCountry: "AT" },
  alumniOf: [
    {
      "@type": "EducationalOrganization",
      name: "HTL Wiener Neustadt",
      url: "https://www.htlwrn.ac.at",
    },
  ],
  memberOf: [
    {
      "@type": "Organization",
      name: "flyby racing — autonomous drone racing team",
      url: "https://robo4you.at/teams/",
    },
    {
      "@type": "Organization",
      name: "robo4you robotics club",
      url: "https://robo4you.at",
    },
  ],
  knowsAbout: [
    "Robotics",
    "Autonomous systems",
    "Reinforcement learning",
    "ROS (Robot Operating System)",
    "Computer vision",
    "State estimation",
    "Nix / NixOS",
    "DevOps",
    "C++",
    "Rust",
    "Python",
  ],
  award: [
    "1st place, IEIIC International Embodied Intelligence Challenge (2026)",
    "1st place, A2RL Silver Group multi-drone race, Abu Dhabi (2026)",
    "Innovation Award 2025/26, ecoplus Technopol Wiener Neustadt",
    "3rd place, VEX AI World Championship, Houston (2025)",
    "3rd place, GCER World Championship Botball, Charlotte (2024)",
    "1st place, ECER European Championship Botball, Vienna (2024)",
  ],
  sameAs: [
    "https://github.com/AkosPapp",
    "https://at.linkedin.com/in/it-akos-papp",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Akos Papp" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="akosp.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://akosp.app${Astro.url.pathname}`} />
    <meta property="og:image" content="https://akosp.app/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://akosp.app/og.png" />
    <link rel="author" href="/about/" />
    <link rel="me" href="https://github.com/AkosPapp" />
    <link rel="me" href="https://at.linkedin.com/in/it-akos-papp" />
    <meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={`https://akosp.app${Astro.url.pathname}`} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%232f6f4f'/><text x='32' y='44' font-family='system-ui' font-size='36' font-weight='700' fill='%23f7f7f4' text-anchor='middle'>A</text></svg>"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      :root {
        --bg: #f7f7f4;
        --surface: #ffffff;
        --fg: #191917;
        --muted: #6b6b66;
        --faint: #9b9b95;
        --line: #e3e3de;
        --line-strong: #cfcfc8;
        --accent: #2f6f4f;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e0f11;
          --surface: #16181b;
          --fg: #e9e9e6;
          --muted: #9b9b95;
          --faint: #6b6b66;
          --line: #24262a;
          --line-strong: #34373d;
          --accent: #7fc7a0;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; }
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 16px/1.7 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      .wrap {
        max-width: 46rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a.accent { color: var(--accent); }

      header.site {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 2.2rem 0 0;
        margin-bottom: 4.5rem;
      }
      header.site .wordmark {
        font-family: ui-monospace, "Cascadia Mono", monospace;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      header.site .wordmark:hover { color: var(--accent); }
      header.site nav {
        display: flex;
        gap: 1.2rem;
        font-size: 0.9rem;
        color: var(--muted);
      }
      header.site nav a:hover { color: var(--fg); }
      header.site nav a[aria-current="page"] {
        color: var(--fg);
        font-weight: 600;
      }

      h1 {
        font-size: clamp(1.9rem, 5.5vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        text-wrap: balance;
        margin: 0 0 0.6rem;
      }
      h2 {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--faint);
        margin: 0 0 0.9rem;
      }
      h3 {
        font-size: 1rem;
        font-weight: 620;
        letter-spacing: -0.01em;
        margin: 0 0 0.2rem;
        line-height: 1.4;
        text-wrap: pretty;
      }
      p { margin: 0 0 1rem; text-wrap: pretty; }
      .muted { color: var(--muted); }
      .small { font-size: 0.9rem; }

      section { margin-bottom: 3.2rem; }

      .entry {
        display: grid;
        grid-template-columns: 3.4rem 1fr;
        gap: 0 1.2rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--line);
        transition: border-color 0.15s ease;
      }
      .entry:hover { border-bottom-color: var(--line-strong); }
      .entry:first-child { border-top: 1px solid var(--line); }
      .entry .year {
        color: var(--faint);
        font-family: ui-monospace, "Cascadia Mono", monospace;
        font-size: 0.85rem;
        padding-top: 0.18rem;
      }
      .entry .place {
        color: var(--muted);
        font-size: 0.88rem;
        margin: 0 0 0.3rem;
      }
      .entry p { color: var(--muted); font-size: 0.92rem; margin-bottom: 0.2rem; }
      .entry .team {
        color: var(--faint);
        font-size: 0.84rem;
        font-style: italic;
      }
      .entry.solo { grid-template-columns: 1fr; }

      .card {
        display: block;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 0.9rem;
        transition: border-color 0.15s ease;
      }
      .card:hover { border-color: var(--line-strong); }
      div.card:hover { border-color: var(--line); }
      .card .tag {
        display: inline-block;
        font-family: ui-monospace, "Cascadia Mono", monospace;
        font-size: 0.72rem;
        color: var(--accent);
        border: 1px solid var(--line-strong);
        border-radius: 99px;
        padding: 0.05rem 0.55rem;
        margin-bottom: 0.5rem;
      }
      .card p { color: var(--muted); font-size: 0.92rem; margin: 0; }

      .kv { margin: 0; }
      .kv div {
        display: grid;
        grid-template-columns: 10rem 1fr;
        gap: 0 1.2rem;
        padding: 0.55rem 0;
        border-bottom: 1px solid var(--line);
      }
      .kv div:first-child { border-top: 1px solid var(--line); }
      .kv dt { color: var(--muted); font-size: 0.92rem; }
      .kv dd { margin: 0; font-size: 0.92rem; }

      .linkrow { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; }
      .linkrow a { color: var(--accent); border-bottom: 1px solid transparent; }
      .linkrow a:hover { border-bottom-color: currentColor; }

      .more { font-size: 0.92rem; }

      footer.site {
        color: var(--faint);
        font-size: 0.84rem;
        border-top: 1px solid var(--line);
        padding: 1.1rem 0 3rem;
        margin-top: 4.5rem;
      }
      footer.site a { color: var(--muted); }
      footer.site a:hover { color: var(--accent); }

      @media (max-width: 560px) {
        .entry { grid-template-columns: 1fr; }
        .kv div { grid-template-columns: 1fr; gap: 0.1rem; }
        header.site { flex-direction: column; gap: 0.6rem; }
      }
      ::selection { background: var(--accent); color: var(--bg); }

      @media print {
        header.site nav, footer.site a { display: none; }
        body { background: #fff; color: #000; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="wordmark" href="/">akosp.app</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.label === active ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site">
        Vienna, Austria · HU native · DE C1 (ÖSD) · EN C2 (CAE) ·
        <a href="https://github.com/AkosPapp">GitHub</a> ·
        <a href="https://at.linkedin.com/in/it-akos-papp">LinkedIn</a>
      </footer>
    </div>
  </body>
</html>
